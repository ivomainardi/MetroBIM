<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Um build gera duas DLLs:
      net8.0-windows  -> Contents\R25\MetroSP.dll  (Civil 3D 2025 = R25.0 e 2026 = R25.1)
      net10.0-windows -> Contents\R26\MetroSP.dll  (Civil 3D 2027 = R26.0)
    As referências da API vêm do NuGet oficial da Autodesk (AutoCAD.NET e Civil3D.NET), então não é
    preciso ter as três versões instaladas para compilar.
      dotnet build src\MetroSP.csproj -c Release
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MetroSP</AssemblyName>
    <RootNamespace>MetroSP</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.8.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <BundleContents>$(MSBuildProjectDirectory)\..\MetroSP.bundle\Contents</BundleContents>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <AcadSeries>R25</AcadSeries>
    <AcadApiVersion>25.0.1</AcadApiVersion>
    <CivilApiVersion>13.7.145</CivilApiVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <AcadSeries>R26</AcadSeries>
    <AcadApiVersion>26.0.0</AcadApiVersion>
    <CivilApiVersion>13.9.628</CivilApiVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- ExcludeAssets=runtime: as DLLs da Autodesk já estão no Civil 3D, não vão para o bundle. -->
    <PackageReference Include="AutoCAD.NET" Version="$(AcadApiVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Civil3D.NET" Version="$(CivilApiVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Depois de cada build, copia a DLL para a pasta da série dentro do bundle. -->
  <Target Name="CopyToBundle" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <BundleFiles Include="$(OutDir)MetroSP.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BundleFiles)" DestinationFolder="$(BundleContents)\$(AcadSeries)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- Ícones, logos e selo da identidade Ação BIM · Metrô SP, embutidos na DLL. -->
    <EmbeddedResource Include="Resources\**\*.png" />
  </ItemGroup>

</Project>
